---
import '../styles/global.css';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';

import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description: string;
  ogType?: 'profile' | 'article' | 'website';
  jsonLdPerson?: boolean;
}

const { title, description, ogType, jsonLdPerson } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script is:inline>
      // Sets the theme class before first paint so there is no flash on reload.
      // Defaults to the system preference. localStorage is used for the theme
      // preference and nothing else.
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var dark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    <SEO title={title} description={description} ogType={ogType} jsonLdPerson={jsonLdPerson} />
  </head>
  <body>
    <a href="#main" class="skip-link t-label">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
