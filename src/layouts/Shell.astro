---
// Two-column shell used by every page except the case studies, which supply
// their own sidebar content through the same grid. Geometry is measured, see
// ref/ANALYSIS.md section 2.
import ProfileCard from '../components/ProfileCard.astro';
import Base from './Base.astro';

interface Props {
  title?: string;
  description: string;
  ogType?: 'profile' | 'article' | 'website';
  jsonLdPerson?: boolean;
}

const { title, description, ogType, jsonLdPerson } = Astro.props;
---
<Base title={title} description={description} ogType={ogType} jsonLdPerson={jsonLdPerson}>
  <div class="shell">
    <div class="shell-grid">
      {Astro.slots.has('side') ? (
        <div class="shell-side"><slot name="side" /></div>
      ) : (
        <div class="shell-side" transition:persist="profile"><ProfileCard /></div>
      )}
      <div class="shell-main">
        <slot />
      </div>
    </div>
  </div>
</Base>
