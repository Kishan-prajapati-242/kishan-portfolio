{/* Boxes, not an SVG path: percentages are not valid in path data. */}
<div class="divider" aria-hidden="true">
  <span class="divider-cap"></span>
  <span class="divider-rule"></span>
  <span class="divider-cap divider-cap-end"></span>
</div>

<style>
  .divider {
    position: relative;
    height: 9px;
    margin-block: 4rem;
  }

  .divider-cap {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 9px;
    background-color: var(--color-grid);
  }

  .divider-cap-end {
    left: auto;
    right: 0;
  }

  .divider-rule {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--color-grid);
    transform-origin: 0 50%;
  }

  @supports (animation-timeline: view()) {
    .divider-rule {
      transform: scaleX(0);
      animation: divider-draw linear both;
      animation-timeline: view();
      animation-range: cover 10% cover 45%;
    }

    .divider-cap-end {
      opacity: 0;
      animation: divider-cap-in linear both;
      animation-timeline: view();
      animation-range: cover 38% cover 48%;
    }

    @keyframes divider-draw {
      to { transform: scaleX(1); }
    }

    @keyframes divider-cap-in {
      to { opacity: 1; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .divider-rule,
    .divider-cap-end {
      transform: none !important;
      opacity: 1 !important;
      animation: none !important;
    }
  }
</style>
