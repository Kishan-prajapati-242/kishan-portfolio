---
// The target is in the inline style and the keyframe runs from zero, so with the
// animation off the final value still shows.
export interface Props {
  value: number;
  spoken: string;
  suffix?: string;
  delay?: number;
}

const { value, spoken, suffix = '', delay = 0 }: Props = Astro.props;

const groups = value.toLocaleString('en-US').split(',');
const targets = groups.map((g) => Number.parseInt(g, 10));
const keyframes = [...new Set(targets)]
  .map((t) => `@keyframes cnt-${t}{from{--n:0}}`)
  .join('');
---
<span class="counter">
  <span class="sr-only">{spoken}</span>
  <span class="counter-groups" aria-hidden="true">
    {targets.map((t, i) => (
      <>
        {i > 0 && <span class="counter-comma">,</span>}
        <span
          class:list={['counter-group', i === 0 ? 'is-lead' : 'is-pad']}
          style={`--n:${t};animation-name:cnt-${t};animation-delay:${delay}ms`}
        ></span>
      </>
    ))}
    {suffix && <span class="counter-suffix">{suffix}</span>}
  </span>
</span>
<style is:inline set:html={keyframes}></style>
