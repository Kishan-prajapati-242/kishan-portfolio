---
// The container primitive. DESIGN.md section 4.
// No shadow, no lift, no scale: the only hover affordance is the border
// picking up the accent colour, which keeps the graph paper reading as the
// surface everything sits on.
export interface Props {
  as?: string;
  class?: string;
}

const { as: Tag = 'div', class: className }: Props = Astro.props;
---
<Tag class:list={['card', className]}>
  <slot />
</Tag>

<style>
  .card {
    border: 1px solid var(--color-grid);
    border-radius: var(--radius-card);
    background-color: var(--color-paper);
    padding: 24px;
    transition: border-color 120ms;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-plot);
  }
</style>
