---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import Card from './Card.astro';
import Measurement from './Measurement.astro';

export interface Props {
  entry: CollectionEntry<'work'>;
  art?: ImageMetadata;
  showMeasurement?: boolean;
  featured?: boolean;
  headingLevel?: 2 | 3;
}

const {
  entry,
  art,
  showMeasurement = true,
  featured = false,
  headingLevel = 2,
}: Props = Astro.props;

const { title, summary, status, stack, cardArtAlt, timeline, repo, demo } = entry.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const year = timeline?.match(/\b(20\d{2})\b/)?.[1];

// The headline number for each project, quoted from CONTENT.md. ATCTM and
// MoodLens are absent deliberately: CONTENT.md records no measured figure for
// either, and a card is not a reason to invent one.
const highlights: Record<
  string,
  { label: string; value: string; unit?: string; provenance: string }
> = {
  sieve: {
    label: 'end-to-end retrieval speedup',
    value: '6.3',
    unit: 'x',
    provenance:
      '62.6 ms (query embed plus sequential scan) against 9.9 ms (query embed plus HNSW), both p50, same timing window on both sides. The retrieval-only ratio is 24x, but that excludes the encoder, which is 77 percent of end-to-end p50 and is the floor no index tuning can move.',
  },
  gatekeepnt: {
    label: 'Spearman correlation, entity retention gap against SARI',
    value: '-0.84',
    provenance:
      '28 model-by-dataset cells. p < 10^-7. Block-permutation p < 10^-4 over 10,000 shuffles. Single seed (42) throughout because of compute limits, so no seed variance is reported.',
  },
  moodinsight: {
    label: 'accuracy, published figure',
    value: '88.10',
    unit: 'percent',
    provenance:
      'Multinomial Naive Bayes on TF-IDF plus sentiment polarity features over 20,000 labelled English tweets, an improvement of over 8 percent on prior work using the same dataset. This is the figure in the peer-reviewed ICICC chapter.',
  },
};

const highlight = showMeasurement ? highlights[entry.id] : undefined;
---
<Card class:list={['project-card', featured && 'project-card-featured', entry.id === 'sieve' && 'is-flagship']}>
  <a class="art" href={`/work/${entry.id}`} tabindex="-1" aria-hidden="true">
    <span class="chrome">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    </span>
    <span class="screen">
      {art ? (
        <Image src={art} alt={cardArtAlt ?? ''} width={800} height={450} loading="lazy" />
      ) : (
        <span class="art-empty"></span>
      )}
    </span>
  </a>

  <p class="meta">
    <span class="pill t-label">{status}</span>
    {year && <span class="year t-label">{year}</span>}
  </p>

  <Heading class="title">
    <a href={`/work/${entry.id}`}>{title}</a>
  </Heading>

  <p class="summary">{summary}</p>

  <ul class="chips">
    {stack.slice(0, 4).map((c) => <li class="chip t-label">{c}</li>)}
    {stack.length > 4 && <li class="chip t-label">+{stack.length - 4}</li>}
  </ul>

  {highlight && (
    <div class="highlight">
      <Measurement
        label={highlight.label}
        value={highlight.value}
        unit={highlight.unit}
        state="measured"
        provenance={highlight.provenance}
      />
    </div>
  )}

  <p class="more t-label">
    <a href={`/work/${entry.id}`}>Read the case study</a>
    {demo && <a class="second" href={demo}>Open the live demo</a>}
    {!demo && repo && <a class="second" href={repo}>View the code</a>}
  </p>
</Card>


<style>
  .project-card {
    display: flex;
    flex-direction: column;
  }

  /* The art runs to the card edges, so the negative margin cancels the card's
     24px padding. The slot holds its 16:9 shape whether or not a file exists,
     so a card without art reads as deliberate rather than broken. */
  /* A raw screenshot reads as a screenshot. Framed, it reads as a product. */
  .art {
    display: block;
    line-height: 0;
    margin: 0 0 20px;
    border: 1px solid var(--color-grid);
    border-radius: 6px;
    overflow: hidden;
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    background-color: var(--color-paper-2);
    border-bottom: 1px solid var(--color-grid);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-grid);
  }

  .screen {
    display: block;
    /* The zoom happens inside this frame, so the card itself never resizes and
       nothing below it reflows. */
    overflow: hidden;
  }

  .art :global(img),
  .art-empty {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
  }

  /* The hover gesture itself is in global.css. .is-flagship is set on the Card
     component's root element rather than on anything this file renders, so a
     scoped selector for it would be relying on class-prop scope propagation to
     reach an element another component owns. Global is where it belongs. */

  .art-empty {
    background-color: var(--color-paper-2);
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 1rem;
  }

  .pill {
    border: 1px solid var(--color-grid);
    border-radius: 999px;
    padding: 4px 10px;
    color: var(--color-ink-2);
  }

  .year {
    color: var(--color-ink-3);
    font-variant-numeric: tabular-nums;
  }

  .title {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-row-title);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover,
  .title a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .summary {
    color: var(--color-ink-2);
    font-size: 1rem;
    line-height: 1.45;
    margin: 0 0 1.25rem;
  }

  .chips {
    margin: 0 0 1.5rem;
  }

  .highlight {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-grid);
    margin-bottom: 1.5rem;
  }

  .more {
    margin: auto 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
</style>
