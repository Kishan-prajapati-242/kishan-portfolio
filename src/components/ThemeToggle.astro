---
// Toggles the .dark class on html and persists the choice.
// localStorage is used for the theme preference and nothing else.
//
// D-019: the accessible name is computed from this button's own contents, so
// it contains the visible text and satisfies WCAG 2.5.3 Label in Name. No
// aria-label and no aria-pressed. Both states are rendered and CSS picks one
// from the .dark class on html, which the inline script in Base.astro sets
// before first paint. The icons are hand-authored and aria-hidden, so they add
// nothing to the name.
---
<button id="theme-toggle" type="button" class="t-label">
  <span class="icons" aria-hidden="true">
    <svg class="icon icon-sun" viewBox="0 0 20 20" width="16" height="16" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <circle cx="10" cy="10" r="3.5" />
      <path d="M10 1.5v2M10 16.5v2M18.5 10h-2M3.5 10h-2M16 4l-1.4 1.4M5.4 14.6 4 16M16 16l-1.4-1.4M5.4 5.4 4 4" />
    </svg>
    <svg class="icon icon-moon" viewBox="0 0 20 20" width="16" height="16" fill="none"
         stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16.5 11.8A7 7 0 0 1 8.2 3.5a7 7 0 1 0 8.3 8.3z" />
    </svg>
  </span>
  <span class="state state-light">theme: light<span class="sr-only">, switch to dark</span></span>
  <span class="state state-dark">theme: dark<span class="sr-only">, switch to light</span></span>
</button>

<script>
  // astro:page-load fires on the initial load and after every client-side
  // navigation. Binding on DOMContentLoaded alone would leave the toggle dead
  // after the first page change.
  document.addEventListener('astro:page-load', () => {
    const button = document.getElementById('theme-toggle');
    if (!button || button.dataset.bound === 'true') return;
    button.dataset.bound = 'true';
    button.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {
        /* storage unavailable: the theme still switches for this page view */
      }
    });
  });
</script>

<style>
  button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: 1px solid var(--color-grid);
    /* Everything else on the site is rounded; this one is a pill. */
    border-radius: 999px;
    color: var(--color-ink-2);
    padding: 0.5rem 0.75rem;
    cursor: pointer;
  }

  .icons {
    position: relative;
    display: block;
    width: 16px;
    height: 16px;
    flex: none;
  }

  .icon {
    position: absolute;
    inset: 0;
    transition: opacity var(--dur-fast) var(--ease-out-quart),
      transform var(--dur-fast) var(--ease-out-quart);
  }

  .icon-sun {
    opacity: 1;
    transform: rotate(0deg);
  }

  .icon-moon {
    opacity: 0;
    transform: rotate(-90deg);
  }

  :global(.dark) .icon-sun {
    opacity: 0;
    transform: rotate(90deg);
  }

  :global(.dark) .icon-moon {
    opacity: 1;
    transform: rotate(0deg);
  }

  /* Only one state is in the tree at a time, so the accessible name is
     "theme: light, switch to dark" or "theme: dark, switch to light". */
  .state-dark {
    display: none;
  }

  :global(.dark) .state-light {
    display: none;
  }

  :global(.dark) .state-dark {
    display: inline;
  }
</style>
