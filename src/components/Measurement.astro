---
// The signature component, DESIGN.md section 5.
//
// The state contract is D-002 and it is enforced here rather than left to
// convention. A measured value without provenance, or an unmeasured block
// that claims provenance, must be impossible to render on this site. That
// constraint is the point of the component, so the checks throw at build
// time and name the exact violation.
//
//   measured    provenance required, reason forbidden
//   unmeasured  provenance forbidden, reason required
//   withdrawn   reason required, provenance optional

export interface Props {
  label: string;
  value?: string;
  unit?: string;
  range?: [number, number];
  ci?: string;
  provenance?: string;
  state: 'measured' | 'unmeasured' | 'withdrawn';
  reason?: string;
  href?: string;
}

const { label, value, unit, range, ci, provenance, state, reason, href } = Astro.props;

const filled = (s?: string) => typeof s === 'string' && s.trim().length > 0;
const at = `<Measurement label="${label}">`;

if (state === 'measured') {
  if (!filled(provenance)) {
    throw new Error(
      `${at} state "measured" requires provenance, and it is missing or empty. Every measured value on this site states the conditions it was measured under.`
    );
  }
  if (filled(reason)) {
    throw new Error(
      `${at} state "measured" forbids reason. A measured value explains itself through provenance. Move the text into provenance, or change the state.`
    );
  }
} else if (state === 'unmeasured') {
  if (!filled(reason)) {
    throw new Error(
      `${at} state "unmeasured" requires reason, and it is missing or empty. Say what was not measured and why it was not measured.`
    );
  }
  if (filled(provenance)) {
    throw new Error(
      `${at} state "unmeasured" forbids provenance. Nothing was measured, so there are no conditions to state. Move the text into reason.`
    );
  }
} else if (state === 'withdrawn') {
  if (!filled(reason)) {
    throw new Error(
      `${at} state "withdrawn" requires reason, and it is missing or empty. Say why the measurement was withdrawn.`
    );
  }
}

// Error bar geometry. DESIGN.md section 5 fixes the shape but not the domain,
// so the domain is the range itself, mapped onto the middle 80 percent of the
// track. The end caps then never sit flush against the edge of the block.
const BAR_START = 10;
const BAR_END = 90;
const hasRange = Array.isArray(range) && range.length === 2 && range[0] !== range[1];

let tickPct = 50;
if (hasRange && value !== undefined) {
  const [lo, hi] = range as [number, number];
  // Values keep their thousands separators when displayed, so strip them
  // before parsing. "1,126" must not parse as 1.
  const t = (Number.parseFloat(value.replace(/,/g, '')) - lo) / (hi - lo);
  tickPct = Number.isFinite(t)
    ? BAR_START + (BAR_END - BAR_START) * Math.min(1, Math.max(0, t))
    : 50;
}

const spoken = `${value ?? ''}${unit ? ` ${unit}` : ''}`.trim();
const barLabel = hasRange
  ? `Point estimate ${spoken}, on a range from ${(range as [number, number])[0]} to ${(range as [number, number])[1]}.`
  : `Point estimate ${spoken}, reported without a range.`;

const Tag = href ? 'a' : 'div';
---
<Tag class:list={['measurement', `is-${state}`, href && 'is-linked']} href={href}>
  <p class="t-label label">{label}</p>

  {state === 'unmeasured' ? (
    <p class="value-row">
      <span class="null-bracket">[</span>
      <span class="null-rule"></span>
      <span class="null-bracket">]</span>
      <span class="null-word">null</span>
    </p>
  ) : (
    <p class="value-row">
      <span class="value">{value}</span>
      {unit && <span class="unit">{unit}</span>}
      {ci && <span class="ci">{ci}</span>}
    </p>
  )}

  {state === 'unmeasured' ? (
    <div class="bar-slot" aria-hidden="true"></div>
  ) : (
    <svg
      class="bar"
      width="100%"
      height="14"
      role="img"
      aria-label={barLabel}
      shape-rendering="crispEdges"
    >
      {hasRange && <line class="bar-rule" x1={`${BAR_START}%`} x2={`${BAR_END}%`} y1="7.5" y2="7.5" />}
      {hasRange && <line class="bar-cap" x1={`${BAR_START}%`} x2={`${BAR_START}%`} y1="3" y2="11" />}
      {hasRange && <line class="bar-cap" x1={`${BAR_END}%`} x2={`${BAR_END}%`} y1="3" y2="11" />}
      <line class="bar-tick" x1={`${tickPct}%`} x2={`${tickPct}%`} y1="1" y2="13" />
    </svg>
  )}

  <div class="notes">
    {state === 'measured' && <p class="provenance">{provenance}</p>}
    {state === 'unmeasured' && (
      <p class="reason reason-unmeasured"><span class="t-label tag">Not measured</span>{reason}</p>
    )}
    {state === 'withdrawn' && (
      <p class="reason reason-withdrawn"><span class="t-label tag">Withdrawn</span>{reason}</p>
    )}
    {state === 'withdrawn' && filled(provenance) && <p class="provenance">{provenance}</p>}
  </div>
</Tag>

<style>
  .measurement {
    color: inherit;
    text-decoration: none;
  }

  .label {
    color: var(--color-ink-3);
    margin: 0;
  }

  .value-row {
    display: flex;
    align-items: baseline;
    gap: 0.25em;
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--text-data-big);
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  .unit {
    font-size: 0.45em;
    color: var(--color-ink-2);
  }

  .ci {
    font-size: var(--text-data);
    color: var(--color-ink-2);
  }

  /* The unmeasured value slot, DESIGN.md section 5. It occupies the height
     the number would have taken, so a row of blocks stays aligned. */
  .null-bracket,
  .null-word {
    color: var(--color-null);
  }

  .null-rule {
    flex: 1 1 auto;
    align-self: center;
    height: 0;
    border-top: 1px dotted var(--color-null);
  }

  .null-word {
    font-size: var(--text-data);
  }

  .bar,
  .bar-slot {
    display: block;
    width: 100%;
    height: 14px;
    overflow: visible;
  }

  .bar-rule,
  .bar-cap {
    stroke: var(--color-ink-3);
    stroke-width: 1;
  }

  .bar-tick {
    stroke: var(--color-plot);
    stroke-width: 2;
  }

  /* D-022. Deliberately not the label role: provenance runs to several
     sentences and 0.11em tracking at 11px is not readable at that length. */
  .provenance {
    margin: 0;
    color: var(--color-ink-3);
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.875rem;
    letter-spacing: 0;
    line-height: 1.5;
  }

  .reason {
    margin: 0 0 0.5rem;
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .notes > .reason:last-child {
    margin-bottom: 0;
  }

  .tag {
    margin-right: 0.5em;
  }

  .reason-unmeasured,
  .reason-unmeasured .tag {
    color: var(--color-annot);
  }

  .reason-withdrawn,
  .reason-withdrawn .tag {
    color: var(--color-withdrawn);
  }

  /* Struck through as a pseudo-element rather than <s>, so the number stays
     readable and the rule is exactly 1px. */
  .is-withdrawn .value {
    position: relative;
  }

  .is-withdrawn .value::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background-color: var(--color-withdrawn);
  }

  .is-linked:hover .label,
  .is-linked:focus-visible .label {
    color: var(--color-plot);
  }
</style>
