---
// Content Layer API: entries use id, not slug, and render(entry), not entry.render().
import { getCollection, render } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<CaseStudy entry={entry} headings={headings}>
  <Content />
</CaseStudy>
